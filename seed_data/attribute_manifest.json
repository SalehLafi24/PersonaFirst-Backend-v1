    "age_group": {
      "object_type": "product",
      "taxonomy": {
        "kind": "closed",
        "cardinality": "single",
        "normalization_ref": "age_group",
        "unmatched_policy": "discard",
        "allowed_values": [
          "newborn",
          "infant",
          "toddler",
          "kids",
          "teen",
          "adult",
          "universal"
        ]
      },
      "input": {
        "modes": [
          "csv_direct",
          "regex_extract",
          "llm_evidence",
          "contextual_defaults"
        ],
        "precedence": [
          "csv_direct",
          "regex_extract",
          "llm_evidence",
          "contextual_defaults"
        ],
        "contextual_defaults": {
          "_doc": "Phase A: when CSV is silent and no regex/LLM event fires, default age_group from product_type. Adult-targeted product types like supplements, feminine_care, makeup default to 'adult'. Generic mechanism applicable to other attributes too.",
          "rules": [
            {
              "if_product_type_in": ["supplement", "feminine_care", "makeup", "coffee", "tea", "mug", "skincare", "hair_care"],
              "value": "adult",
              "confidence": 0.65,
              "rationale": "adult-targeted product types default to age_group=adult when CSV is silent"
            }
          ]
        },
        "csv_direct": {
          "csv_path": "seed_data/mumz_products.csv",
          "product_id_column": "sku",
          "source_columns": [
            "age"
          ]
        },
        "regex_extract": {
          "fields": [
            "name"
          ],
          "patterns": [
            {
              "pattern": "(?i)\\b0\\s*-?\\s*3\\s*m(?:onths?)?\\b",
              "value": "newborn",
              "confidence": 0.92
            },
            {
              "pattern": "(?i)\\bnewborn\\b",
              "value": "newborn",
              "confidence": 0.95
            },
            {
              "pattern": "(?i)\\b(?:0\\s*-\\s*(?:6|12)\\s*m|0\\s*-\\s*2\\s*y(?:ears?)?)\\b",
              "value": "infant",
              "confidence": 0.9
            },
            {
              "pattern": "(?i)\\b(?:infant|baby|babies)\\b",
              "value": "infant",
              "confidence": 0.85
            },
            {
              "pattern": "(?i)\\b(?:12\\s*-\\s*36\\s*m|2\\s*-\\s*4\\s*y(?:ears?)?)\\b",
              "value": "toddler",
              "confidence": 0.9
            },
            {
              "pattern": "(?i)\\btoddlers?\\b",
              "value": "toddler",
              "confidence": 0.88
            },
            {
              "pattern": "(?i)\\b(?:5\\s*-\\s*7\\s*y(?:ears?)?|school\\s*age|kindergarten)\\b",
              "value": "kids",
              "confidence": 0.88
            },
            {
              "pattern": "(?i)\\bkids?\\b",
              "value": "kids",
              "confidence": 0.8
            },
            {
              "pattern": "(?i)\\b(?:8\\+|teens?|tweens?)\\b",
              "value": "teen",
              "confidence": 0.85
            },
            {
              "pattern": "(?i)\\b(?:adult|adults|mom|mother|father|parent)s?\\b",
              "value": "adult",
              "confidence": 0.78
            },
            {
              "_doc": "B2c: explicit gendered-adult phrases. Helps out-of-domain products that lack a csv_direct event (empty CSV age cell).",
              "pattern": "(?i)\\b(men's|mens|women's|womens|gentlemen|gentleman|ladies)\\b",
              "value": "adult",
              "confidence": 0.92
            },
            {
              "_doc": "B2c: 'For Men' / 'For Women' phrasing.",
              "pattern": "(?i)\\bfor\\s+(?:men|women|him|her)\\b",
              "value": "adult",
              "confidence": 0.92
            }
          ]
        },
        "llm_evidence": {
          "fields": [
            "name"
          ],
          "class_name": "contextual_semantic",
          "max_objects_per_run": 30
        }
      },
      "proposal": {
        "confidence_min": 0.5,
        "max_values_per_object": 1,
        "require_evidence": true
      },
      "approval": {
        "min_proposal_count": 3,
        "min_distinct_objects": 2,
        "min_avg_confidence": 0.85
      },
      "backfill": {
        "_doc": "Phase A pilot tested multi_event_resolution=most_specific here and reverted. Reason: on 'Probiotic Gummies For Kids' the regex layer emitted toddler/kids/teen events all at conf=0.98; most_specific picked toddler, but the gold label was kids (driven by the 'For Kids' phrase). Specificity-band resolution can't distinguish 'named age band in title' from 'age range covered'. Phrase-aware extraction is the right fix and is deferred. Keeping highest_confidence here.",
        "strategy": "highest_confidence",
        "single_row_per_object": true,
        "idempotent": true
      },
      "default_policy": {
        "on_unresolved": "leave_null"
      },
      "recommendation": {
        "persona_relevant": true,
        "score_weight": 0.366465,
        "usage": "cohort_key",
        "signal_tags": [
          "cross_segment_guard"
        ],
        "_weight_reason": "suggester_v2"
      }
    },
